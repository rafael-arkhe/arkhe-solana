{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Golden Vectors v1",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "generated_by": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "vectors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "component": { "type": "string" },
          "normative_source": { "type": "string" },
          "description": { "type": "string" },
          "input": { "type": "object" },
          "expected_output": { "type": "object" }
        },
        "required": ["id", "component", "normative_source", "description", "input", "expected_output"]
      }
    }
  },
  "required": ["$schema", "version", "generated_by", "generated_at", "vectors"]
}
